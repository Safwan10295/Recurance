# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# Passwords: letters and digits only (they are placed inside connection strings and SQL).

# Database
POSTGRES_PASSWORD=
WEB_DB_PASSWORD=

# Public address. A domain pointed at the server, or <ip-with-dashes>.sslip.io, or :80 for plain HTTP while testing.
SITE_ADDRESS=
# The full public address, used in share previews, e.g. https://203-0-113-5.sslip.io
SITE_URL=

# Live brief (web container). Use a separate Token Factory key from the pipeline's.
NEBIUS_LIVE_API_KEY=

# Live brief limits.
LIVE_COST_CEILING_USD=4.50
LIVE_GLOBAL_DAILY_CAP=40
LIVE_PER_IP_DAILY_CAP=5
# Set to 1 to switch the live brief off without a redeploy.
LIVE_BRIEF_PAUSED=
# The tool-calling agent: set LIVE_AGENT=off to use only the fixed pipeline.
LIVE_AGENT=on
LIVE_AGENT_MAX_ROUNDS=5
LIVE_AGENT_MAX_COST_USD=0.015
# The live agent's web checks (Tavily, from TAVILY_API_KEY below).
LIVE_TAVILY_DAILY_CREDITS=8
LIVE_TAVILY_TOTAL_CREDITS=230

# Scheduled refresh (worker container).
SCRAPER_CONTACT_EMAIL=
NEBIUS_API_KEY=

TAVILY_API_KEY=

# Refresh schedule.
REFRESH_EVERY_HOURS=168
REFRESH_MAX_SPEND=0.50
# Set to 1 to keep the worker idle.
REFRESH_PAUSED=

# Shown on the methodology page.
CORRECTIONS_EMAIL=
REPO_URL=
