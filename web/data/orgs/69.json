{"id":69,"name":"Association of Ambulance Chief Executives","type":"ambulance","national":false,"n_reports":27,"n_chains":3,"reports":[{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/sally-perrons/","title":"Sally Perrons","date":"2014-04-09","coroner":"Heidi Connor","area":"Nottinghamshire","ref":"2014-0158","categories":["Community health care and emergency services related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2014/04/2014-0158-Response-by-Association-Ambulance-Chief-Executives.pdf","filename":"2014-0158-Response-by-Association-Ambulance-Chief-Executives.pdf","promises":[{"id":530,"quote":"Development of a national recognised teaching standard for the stepwise airway management and ventilation. This will include airway positioning, simple adjuncts and advanced techniques which include supraglottic devices and paramedic intubation. This standard will describe how a paramedic will be initially trained and deemed competent to practice the skill of intubation. This action to be completed by July 2015.","summary":"Develop national teaching standard for paramedic intubation and airway management.","timescale":"July 2015"}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/rajesh-parkash/","title":"Rajesh Parkash","date":"2014-05-08","coroner":"Richard Travers","area":"Surrey","ref":"2014-0207","categories":["Community health care and emergency services related deaths"],"responses":[]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/kingsley-burrell/","title":"Kingsley Burrell","date":"2015-03-20","coroner":"Louise Hunt","area":"Birmingham and Solihull","ref":"2015-0472","categories":["Mental Health related deaths","State Custody related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2015/03/2015-0472-Response-by-Metropolitan-Police.pdf","filename":"2015-0472-Response-by-Metropolitan-Police.pdf","promises":[{"id":493,"quote":"My concern is that this has not been rolled out nationally and therefore many other forces will not understand the implication of this condition and how best to treat it. | suggest contact is made with Chief Inspector | Og WMP for full information on the changes made in the West Midlands Area","summary":"National rollout of training on acute behavioral disturbance to prevent restraint deaths","timescale":null}]},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2015/03/2015-0472-Response-by-Association-of-Ambulance-Chief-Executives.pdf","filename":"2015-0472-Response-by-Association-of-Ambulance-Chief-Executives.pdf","promises":[{"id":50,"quote":"We have made a recommendation to the National Education Network for Ambulance Services leads (NENAS) that each trust considers including, if not completed already, the education of front line staff and control room staff in acute behavioural disturbance to raise awareness of the condition and how it can present in a patient.","summary":"Recommend education for frontline staff on acute behavioural disturbance.","timescale":"November 2015"}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/mia-gibson/","title":"Mia Gibson","date":"2016-05-11","coroner":"Heidi Connor","area":"Nottinghamshire","ref":"2016-0180","categories":["Child Death (from 2015)","Hospital Death (Clinical Procedures and medical management) related deaths"],"responses":[]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/douglas-oak/","title":"Douglas Oak","date":"2019-10-24","coroner":"Rachael Griffin","area":"Dorset","ref":"2019-0352","categories":["Other related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2019/11/2019-0352-Response-by-St-Johns-Ambulance.pdf","filename":"2019-0352-Response-by-St-Johns-Ambulance.pdf","promises":[{"id":1813,"quote":"providing additional Continuous Professional Development training around Acute Behavioural Disturbance","summary":"provide additional CPD training on acute behavioural disturbance","timescale":null}]},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2019/11/2019-0352-Response-by-Association-of-Ambulance-Chief-Executives.pdf","filename":"2019-0352-Response-by-Association-of-Ambulance-Chief-Executives.pdf","promises":[{"id":49,"quote":"We will address each of your concerns, insofar as we are able.","summary":"Address each concern as able","timescale":null}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/helen-sheath/","title":"Helen Sheath","date":"2020-01-27","coroner":"Emma Whitting","area":"Bedfordshire and Luton","ref":"2020-0107","categories":["Emergency services related deaths (2019 onwards)","Mental Health related deaths","Other related deaths","Emergency Services related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2022/06/2020-0107-Response-from-Association-of-Chief-Executives_Redacted.pdf","filename":"2020-0107-Response-from-Association-of-Chief-Executives_Redacted.pdf","promises":[]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/shante-turay-thomas/","title":"Shanté Turay-Thomas","date":"2020-01-27","coroner":"Mary Hassell","area":"Inner North London","ref":"2020-0124","categories":["Community health care and emergency services related deaths","Emergency services related deaths (2019 onwards)","Other related deaths","Emergency services related deaths","Community healthcare related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2022/06/2020-0124-Association-of-Ambulance-Chief-Executives_Redacted.pdf","filename":"2020-0124-Association-of-Ambulance-Chief-Executives_Redacted.pdf","promises":[{"id":1006,"quote":"we have worked closely with NHS England and other partners to reduce the variation as far as possible. Specifically, in relation to anaphylactic shock we have previously made representation to NHS England through the now disbanded Ambulance Response Programme Delivery Group (ARP DG) Chairman: Professor Anthony C Marsh QAM SBStJ DSci (Hon) MBA MSc MA FASI Managing Director: Martin Flaherty OBE and the Emergency Call Prioritisation Advisory Group (ECPAG) requesting that the clinical coding inconsistency","summary":"worked with NHS England to resolve coding inconsistency","timescale":null}]},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2022/06/2020-0124-Response-from-Radcliffes-Le-Brasseur_Redacted.pdf","filename":"2020-0124-Response-from-Radcliffes-Le-Brasseur_Redacted.pdf","promises":[{"id":1915,"quote":"Following Ms [name redacted]Thomas' death, the Practice undertook an audit in October 2019 of all patients who were being prescribed Emerade to ensure that the dosage was in accordance with the BNF based on the respective patients' weight and age. Indeed, all patients who use AAI pens have had their doses reviewed. Patients have been contacted to ensure that they have the correct dose and appropriate knowledge about the use and storage of the pen. Letters were sent to patients on Emerade, which included","summary":"Audit of Emerade patients to verify dosing and contact patients","timescale":"October 2019"}]},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2022/06/2020-0124-Response-from-NICE_Redacted.pdf","filename":"2020-0124-Response-from-NICE_Redacted.pdf","promises":[{"id":1286,"quote":"we will consider how best to make clear In CG134 the advice that 2 adrenaline auto-injectors should be prescribed, which patients should carry at 811 tfflls.","summary":"Plan to clarify guidance on prescribing two adrenaline auto-injectors in CG134 guideline","timescale":null}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/sarah-ferneyhough/","title":"Sarah Ferneyhough","date":"2020-09-29","coroner":"Caroline Beasley-Murray","area":"Essex","ref":"2020-0187","categories":["Alcohol, drug and medication related deaths","Emergency services related deaths (2019 onwards)","Emergency services related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2022/06/2020-0187-Response-from-East-of-England-Ambulance-Service-REDACTED.pdf","filename":"2020-0187-Response-from-East-of-England-Ambulance-Service-REDACTED.pdf","promises":[{"id":591,"quote":"The Trust has already introduced a new EOC Standard Operating Procedure (ESOP) specifically for Mental Health calls and has now made a further revision to the document. Within this ESOP, guidance is given that if the call is abandoned and therefore has incomplete triage (i.e. we haven't been able to seek responses to all the triage questions), and the information provided suggests the patient is actively at risk due to action they have already taken, or currently taking to harm themselves or end","summary":"Introduce ESOP for mental health calls to upgrade abandoned calls to Category 2 when risk is evident","timescale":"December 2020"}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/leon-briggs-prevention-of-future-deaths-report/","title":"Leon Briggs: Prevention of future deaths report","date":"2021-10-04","coroner":"Emma Whitting","area":"Bedfordshire and Luton","ref":"2021-0330","categories":["Emergency services related deaths (2019 onwards)","Mental Health related deaths","Police related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2021/10/2021-0330-Response-from-Association-of-Ambulance-Chief-Executives_Published.pdf","filename":"2021-0330-Response-from-Association-of-Ambulance-Chief-Executives_Published.pdf","promises":[{"id":1558,"quote":"The revised guidance includes wording to highlight that the police officer on scene should call the local ambulance service and include in the information passed whether the patient is being actively restrained and if so how, and if acute behavioural disturbance (ABD) is suspected. Ambulance trusts will assign a Category 2 response to patients detained under S136 and suspected of having ABD unless there are other immediately life-threatening clinical features that would warrant a Category 1","summary":"Update national S136 guidance to require police to notify ambulance service about restraint and suspect ABD","timescale":"recently revised"}]},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2021/10/2021-0330-Response-from-East-of-England-Ambulance-Service_Published.pdf","filename":"2021-0330-Response-from-East-of-England-Ambulance-Service_Published.pdf","promises":[{"id":940,"quote":"EEAST's Mental Health team have also been working on updating the guidance documents for our partners in relation to managing s.136 patients within the community setting. This document 'Requesting Conveyance for Patients Detained under the MHA' will be sent to you once the review and update has been completed in December 2021.","summary":"Update guidance on managing s.136 patients in community settings","timescale":"December 2021"}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/adam-stone-prevention-of-future-deaths-report/","title":"Adam Stone: Prevention of future deaths report","date":"2022-01-27","coroner":"Emma Brown","area":"Birmingham and Solihull","ref":"2022-0026","categories":["Alcohol, drug and medication related deaths","Emergency services related deaths (2019 onwards)","Mental Health related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2022/01/2022-0026-Response-from-Association-of-Ambulance-Chief-Executives_Published.pdf","filename":"2022-0026-Response-from-Association-of-Ambulance-Chief-Executives_Published.pdf","promises":[],"unmatched":true},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2022/01/2022-0026-Response-from-NHS-England-and-NHS-Improvement_Published.pdf","filename":"2022-0026-Response-from-NHS-England-and-NHS-Improvement_Published.pdf","promises":[],"unmatched":true},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2022/01/2022-0026-Response-from-NHS-Digital_Published.pdf","filename":"2022-0026-Response-from-NHS-Digital_Published.pdf","promises":[],"unmatched":true},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2022/01/2022-0026-Response-from-College-of-Paramedics_Published.pdf","filename":"2022-0026-Response-from-College-of-Paramedics_Published.pdf","promises":[],"unmatched":true}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/levi-alleyne-prevention-of-future-deaths-report/","title":"Levi Alleyne: Prevention of future deaths report","date":"2022-11-04","coroner":"Katy Thorne","area":"Berkshire","ref":"2022-0346","categories":["Accident at Work and Health and Safety related deaths","Other related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2022/11/2022-0346-Response-from-AACE.pdf","filename":"2022-0346-Response-from-AACE.pdf","promises":[],"unmatched":true},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2022/11/2022-0346-Response-from-Energy-Networks-Association.pdf","filename":"2022-0346-Response-from-Energy-Networks-Association.pdf","promises":[],"unmatched":true},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2022/11/2022-0346-Response-from-NHS-Digital.pdf","filename":"2022-0346-Response-from-NHS-Digital.pdf","promises":[],"unmatched":true},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2022/11/2022-0346-Response-from-Health-and-Safety-Executive.pdf","filename":"2022-0346-Response-from-Health-and-Safety-Executive.pdf","promises":[],"unmatched":true}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/david-mason-prevention-of-future-deaths-report/","title":"David Mason: Prevention of future deaths report","date":"2023-04-19","coroner":"Nicholas Lane","area":"Worcestershire","ref":"2023-0125","categories":["Hospital Death (Clinical Procedures and medical management) related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2023/04/2023-0125-Response-from-NICE.pdf","filename":"2023-0125-Response-from-NICE.pdf","prom