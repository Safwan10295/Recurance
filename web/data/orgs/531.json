{"id":531,"name":"Driver and Vehicle Standards Agency","type":"other","national":false,"n_reports":12,"n_chains":0,"reports":[{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/raymond-berry/","title":"Raymond Berry","date":"2017-04-07","coroner":"Anna Loxton","area":"Surrey","ref":"2017-0108","categories":["Road (Highways Safety) related deaths"],"responses":[]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/christopher-barnes/","title":"Christopher Barnes","date":"2019-05-20","coroner":"Katy Skerrett","area":"Gloucestershire","ref":"2019-0164","categories":["Road (Highways Safety) related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2019/07/2019-0164-Response-Senior-Traffic-Commissioner-for-Great-Britain.pdf","filename":"2019-0164-Response-Senior-Traffic-Commissioner-for-Great-Britain.pdf","promises":[]},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2019/07/2019-0164-Response-by-RHA.pdf","filename":"2019-0164-Response-by-RHA.pdf","promises":[{"id":1120,"quote":"we suggest that the most appropriate organisation to whom the Coroner could write with such a request is the Health and Safety Executive (HSE).","summary":"Suggest HSE be contacted to draft guidance","timescale":null}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/dudley-howe/","title":"Dudley Howe","date":"2020-03-25","coroner":"Jacqueline Lake","area":"Norfolk","ref":"2020-0079","categories":["Road (Highways Safety) related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2020/04/2020-0079-Response-from-Driver-Vehicle-Standards-Agency-Redacted.pdf","filename":"2020-0079-Response-from-Driver-Vehicle-Standards-Agency-Redacted.pdf","promises":[{"id":8,"quote":"We will introduce two questions to the driving theory test for new drivers of large goods vehicles. These will be on the topic of class VI (cyclops) mirrors and will increase awareness of the positioning and use of the class VI mirror. We will add these to the theory test question bank for the next reprint in autumn 2020.","summary":"Add theory test questions on class VI mirror use for LGV drivers","timescale":"autumn 2020"}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/mollie-gifford/","title":"Mollie Gifford","date":"2020-09-30","coroner":"James Bennett","area":"Birmingham and Solihull","ref":"2020-0211","categories":["Road (Highways Safety) related deaths","Road (Highways safety) related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2022/06/2020-0211-Response-from-DFT-Redacted.pdf","filename":"2020-0211-Response-from-DFT-Redacted.pdf","promises":[{"id":662,"quote":"the DfT is working at international level to develop appropriate requirements to improve vision for drivers around large goods vehicles. This work includes improved direct vision for the driver through vehicle windows and the windscreen, a moving-off information system to provide a warning to the driver if a vulnerable road user is in front of a vehicle, a blind spot information system to detect cyclists alongside vehicles and provide a warning to the driver, and reversing detection using cameras","summary":"Develop international requirements for improved driver vision and safety systems","timescale":"April this year"}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/charlie-hopkins-and-william-robinson-prevention-of-future-deaths-report/","title":"Charlie Hopkins and William Robinson: Prevention of future deaths report","date":"2024-05-14","coroner":"Anna Crawford","area":"Surrey","ref":"2024-0262","categories":["Child Death (from 2015)","Road (Highways Safety) related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2024/05/2024-0262-Response-from-DVSA.pdf","filename":"2024-0262-Response-from-DVSA.pdf","promises":[{"id":588,"quote":"the Department for Transport will be responding to this Regulation 28 Repor