{"id":2420,"name":"National Fire Chiefs Council","type":"council","national":false,"n_reports":5,"n_chains":1,"reports":[{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/ashleigh-timms-prevention-of-future-deaths-report/","title":"Ashleigh Timms: Prevention of future deaths report","date":"2022-04-26","coroner":"Graeme Irvine","area":"East London","ref":"2022-0123","categories":["Emergency services related deaths (2019 onwards)","Other related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2022/04/2022-0123-Response-from-National-Fire-Chiefs-Council.pdf","filename":"2022-0123-Response-from-National-Fire-Chiefs-Council.pdf","promises":[{"id":673,"quote":"The NFCC undertakes, at the earliest opportunity, to seek to ensure that this Concern is reported into these committees to encourage debate and petition for such positive outcomes necessary, and as far as is achievable under this action by the NFCC, to, it is hoped, assuage your apprehension to this Concern.","summary":"Report concern to committees to address staff evacuation competence","timescale":"earliest opportunity"}]},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2022/04/2022-0123-Response-from-Kennedys.pdf","filename":"2022-0123-Response-from-Kennedys.pdf","promises":[{"id":112,"quote":"Face to face fire safety training is now provided to staff. This training is provided annually by Pinnacle and is delivered at each premises. The training covers, amongst other things, evacuation routes and procedures, fire drills and fire safety measures. A copy of the training handbook provided to staff as part of that training is attached.","summary":"Annual fire warden training provided to all staff annually","timescale":"annually"}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/ivan-ignatov-prevention-of-future-deaths-report/","title":"Ivan Ignatov: Prevention of future deaths report","date":"2023-06-08","coroner":"Rachael Griffin","area"