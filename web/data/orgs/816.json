orts/david-alexander/","title":"David Alexander","date":"2017-02-14","coroner":"Lydia Brown","area":"Exeter and Greater Devon","ref":"2017-0044","categories":["Accident at Work and Health and Safety related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2017/03/2017-0044-Response-by-HSE.pdf","filename":"2017-0044-Response-by-HSE.pdf","promises":[{"id":2036,"quote":"The HSE survey of Devon feed mills in 2017 involved an initial fact-finding visit to site by a non- warranted Visiting Officer followed up by a visit from an Inspector","summary":"Conduct site visits to assess risk awareness and mitigation measures","timescale":"2017"}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/alan-walsh/","title":"Alan Walsh","date":"2017-03-03","coroner":"Andrew Harris","area":"London Inner (South)","ref":"2017-0037","categories":["Accident at Work and Health and Safety related deaths"],"responses":[]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/peter-richardson/","title":"Peter Richardson","date":"2017-05-10","coroner":"Simon Wickens","area":"Surrey","ref":"2017-0162","categories":["Other related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2017/08/2017-0162-Response-by-HSE.pdf","filename":"2017-0162-Response-by-HSE.pdf","promises":[{"id":596,"quote":"The HSE intends to issue additional guidance concerning the inspection of two post ramps by thorough examiners to highlight the risks in relation to this type of lifting equipment. This will be covered in HSE Operational Guidance, which will be brought to the attention of the various stakeholder groups, namely the inspection industry and will also be publically available on the HSE website.","summary":"Issue guidance on inspecting two-post lifts to prevent safety failures","timescale":null}]},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2017/08/Peter-Richardson-Response.pdf","filename":"Peter-Richardson-Response