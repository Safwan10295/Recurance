{"id":679,"name":"Google","type":"other","national":false,"n_reports":3,"n_chains":0,"reports":[{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/chloe-macdermott-prevention-of-future-deaths-report/","title":"Chloe Macdermott: Prevention of future deaths report","date":"2023-12-19","coroner":"Paul Rogers","area":"Inner West London","ref":"2023-0534","categories":["Suicide (from 2015)"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2023/12/2023-0534-Response-from-Google-1v2.pdf","filename":"2023-0534-Response-from-Google-1v2.pdf","promises":[]},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2023/12/2023-0534-Response-from-DHSCv2.pdf","filename":"2023-0534-Response-from-DHSCv2.pdf","promises":[{"id":1498,"quote":"seeking to tackle at source the suppliers of harmful substances for the purposes of suicide","summary":"Tackle suppliers of harmful substances to reduce access","timescale":null}]},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2023/12/2023-0534-Response-from-DSIT.pdf","filename":"2023-0534-Response-from-DSIT.pdf","promises":[{"id":1030,"quote":"The act's illegal safety duties will apply to all in-scope 'user-to-user' services which allow users to post content online, or to interact with each other - including online forums. This means that once these duties are in force, they will be required to have systems and processes in place to proactively prevent users from encountering priority illegal content via their service and to minimise the length of time for which such content is present.","summary":"User-to-user services must implement systems to proactively prevent users from encountering priority illegal content and minimise its duration.","timescale":"once these duties are in force"}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/amal-ahmed-prevention-of-future-deaths-report/","title":"Amal Ahmed: Prevention of future deaths report","date":"2023-12-21","coroner":"Sean Cumm