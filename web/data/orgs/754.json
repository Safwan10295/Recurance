{"id":754,"name":"HMP Hewell","type":"prison","national":false,"n_reports":4,"n_chains":1,"reports":[{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/reggie-johns/","title":"Reggie Johns","date":"2013-09-16","coroner":"G U Williams","area":"Worcestershire","ref":"2013-0202","categories":["State Custody related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2014/05/2013-0202-Response-by-NOMS.pdf","filename":"2013-0202-Response-by-NOMS.pdf","promises":[{"id":1245,"quote":"Since Mr Johns' death, HMP Bristol has introduced a system whereby their safer custody team contacts the receiving establishment via email and telephone whenever a prisoner on an open ACCT transfers out of the prison to make the receiving establishment aware of the prisoner's perceived risk of harm. In addition, the escort contractors are also now informed of those prisoners on open ACCTs prior to being transferred out to court or other establishments. These conversations are recorded on Prison-NOMIS","summary":"introduced system to notify receiving establishments of open ACCT transfers","timescale":null}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/gareth-warburton/","title":"Gareth Warburton","date":"2019-12-04","coroner":"David Reid","area":"Worcestershire","ref":"2019-0411","categories":["State Custody related deaths"],"responses":[]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/colin-blackburn-prevention-of-future-deaths-report/","title":"Colin Blackburn: Prevention of future deaths report","date":"2021-09-17","coroner":"David Reid","area":"Worcestershire","ref":"2021-0311","categories":["Mental Health related deaths","State Custody related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2021/09/2021-0311-Response-from-Practice-Plus-Group.pdf","filename":"2021-0311-Response-from-Practice-Plus-Group.pdf","promises":[],"unmatched":true}]},{"url":"https://www.judiciary.u