{"id":537,"name":"Durham County Council","type":"council","national":false,"n_reports":17,"n_chains":2,"reports":[{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/melvin-bandtock/","title":"Melvin Bandtock","date":"2014-04-03","coroner":"Andrew Tweddle","area":"County Durham & Darlington","ref":"2014-0147","categories":["Road (Highways Safety) related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2014/07/2014-0147-Response-by-Durham-Constabulary.pdf","filename":"2014-0147-Response-by-Durham-Constabulary.pdf","promises":[{"id":600,"quote":"The dispatchers for that area would then deploy officers to the incident and contact Durham County Council as appropriate.","summary":"Deploy officers and contact Durham County Council for road incidents","timescale":null}]},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2014/07/2014-0147-Response-by-Durham-County-Council.pdf","filename":"2014-0147-Response-by-Durham-County-Council.pdf","promises":[{"id":1845,"quote":"The Council intends to meet with the forecasters prior to the next winter season to determine whether notifications relating to changes in weather can be improved.","summary":"Meet forecasters before next winter to improve notifications","timescale":"prior to the next winter season"}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/sopefoluwa-peters/","title":"Sopefoluwa Peters","date":"2014-05-08","coroner":"Andrew Tweddle","area":"County Durham & Darlington","ref":"2014-0206","categories":["Other related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2014/07/2014-0206-Response-by-Durham-County-Council.pdf","filename":"2014-0206-Response-by-Durham-County-Council.pdf","promises":[{"id":1382,"quote":"The County Council will also be undertaking a risk assessment along sections of the river bank. This assessment will include representatives from the police who will identify locations, from their local knowledge of where there is a volume of evening and night time activity. If further risks are identified these will be assessed and action will be taken by the County Council to minimise such risks as is considered appropriate.","summary":"Conduct riverbank risk assessment with police to identify and mitigate risks","timescale":"within the next two weeks"}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/jordan-roberts/","title":"Jordan Roberts","date":"2015-02-06","coroner":"Andrew Tweddle","area":"County Durham & Darlington","ref":"2015-0042","categories":["Other related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2015/02/2015-0042-Response-by-Durham-County-Council.pdf","filename":"2015-0042-Response-by-Durham-County-Council.pdf","promises":[{"id":1491,"quote":"Larger, improved hazard waming signs have been erected at 3 key locations along the northem river bank.","summary":"Erected larger warning signs at 3 locations","timescale":"ongoing basis"}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/steven-nicholson/","title":"Steven Nicholson","date":"2016-03-30","coroner":"Karen Dilks","area":"Newcastle Upon Tyne","ref":"2016-0135","categories":["Road (Highways Safety) related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2016/03/Durham-City-Council-Response.pdf","filename":"Durham-City-Council-Response.pdf","promises":[{"id":324,"quote":"we are implementing a scheme to improve the highway drainage at this location by replacing the existing side entry gullies with more effective open top gullies. We expect the works to be complete by the end of July 2016.","summary":"Implement drainage improvement scheme to replace gullies and reduce flooding risk","timescale":"end of July 2016"}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/nathan-charman/","title":"Nathan Charman","date":"2016-07-21","coroner":"Crispin Oliver","area":"County Durham and