{"id":1621,"name":"South East Coast Ambulance Service","type":"ambulance","national":false,"n_reports":13,"n_chains":1,"reports":[{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/kevan-funnell-prevention-of-future-deaths-report/","title":"Kevan Funnell: Prevention of future deaths report","date":"2018-02-27","coroner":"Veronica Hamilton-Deeley","area":"West Sussex, Brighton and Hove","ref":"2024-0095","categories":["Emergency services related deaths (2019 onwards)"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2024/02/2024-0095-Response-from-South-East-Coast-Ambulance-Service-.pdf","filename":"2024-0095-Response-from-South-East-Coast-Ambulance-Service-.pdf","promises":[{"id":25,"quote":"We are currently working with our commissioners in a jointly commissioned demand and capacity review, intended to better align our resource requirements to the demands on our service, particularly in the light of the newly introduced Ambulance Response Programme standards.","summary":"jointly commissioned demand and capacity review to align resources with demand","timescale":null}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/margaret-stemp/","title":"Margaret Stemp","date":"2018-06-25","coroner":"Penelope Schofield","area":"West Sussex","ref":"2018-0198","categories":["Community health care and emergency services related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2018/07/2018-0198-Response-by-South-East-Coast-Ambulance-Service-NHS-Trust.pdf","filename":"2018-0198-Response-by-South-East-Coast-Ambulance-Service-NHS-Trust.pdf","promises":[{"id":908,"quote":"We are aiming to recruit an additional 300 ambulance crew members, so we will have more resources that we can call upon for times of maximum demand.","summary":"Recruit 300 ambulance crew members to increase resources for high demand periods","timescale":"next three years"}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/john-scott/","title":"John Scott","date":"2019-02-14","coroner":"Veronica Hamilton-Deeley","area":"Brighton and Hove","ref":"2019-0051","categories":["Emergency services related deaths (2019 onwards)","Hospital Death (Clinical Procedures and medical management) related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2019/06/2019-0051-Response-by-South-East-Coast-Ambulance-Service-NHS-Trust.pdf","filename":"2019-0051-Response-by-South-East-Coast-Ambulance-Service-NHS-Trust.pdf","promises":[]},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2019/06/2019-0051-Response-by-NHS-Digital.pdf","filename":"2019-0051-Response-by-NHS-Digital.pdf","promises":[{"id":63,"quote":"Call handlers using NHS Pathways are always trained to speak directly with the patient when it is a 3° party call, this ensures that the questions being asked are answered as accurately as possible to ensure both a safe outcome and that questions are not mis-interpreted through a 3 party.","summary":"Train call handlers to ask if caller is alone and advise on contacting others if needed","timescale":"May 2020"}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/mildred-clark/","title":"Mildred Clark","date":"2019-04-25","coroner":"Sonia Hayes","area":"Kent (North-East)","ref":"2019-0127","categories":["Emergency services related deaths (2019 onwards)","Hospital Death (Clinical Procedures and medical management) related deaths"],"responses":[]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/john-wells/","title":"John Wells","date":"2019-12-09","coroner":"Robert Simpson","area":"West Sussex","ref":"2019-0485","categories":["Community health care and emergency services related deaths","Emergency services related deaths (2019 onwards)","Community health care related deaths"],"responses":[]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/steve-cooke-prevention-of-future-deaths-report/","title":"Steve Cooke: Prevention of future deaths report","date":"2021-08-08","coroner":"Sonia Hayes","area":"Mid Kent and Medway","ref":"2021-0266","categories":["Emergency services related deaths (2019 onwards)"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2021/08/2021-0266-Response-from-South-East-Coast-Ambulance-Service_Published.pdf","filename":"2021-0266-Response-from-South-East-Coast-Ambulance-Service_Published.pdf","promises":[{"id":444,"quote":"They have looked at two issues: 1. Our process for establishing the address to which to send an ambulance It has been identified that whilst there was in place clear instruction to 999 call handlers that the caller must give the address rather than the handler suggesting it, this instruction had not been replicated in the 111 system. This is being remedied.","summary":"Remedy missing address instruction in 111 system","timescale":"one to two weeks"},{"id":445,"quote":"Operational Bulletin has been written to update and improve our process when crew on scene are not able to locate the patient. I attach a copy. It will be noted that the process involves the escalation of the incident to a team leader who will listen again to the original call to verify the address, search our records for any previous calls from the same telephone number and identify any sources of further information such as next of kin or a careline. If the team leader can locate a family member or","summary":"Improve patient location verification process","timescale":"one to two weeks"}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/veronica-jenkins-prevention-of-future-deaths-report/","title":"Veronica Jenkins: Prevention of future deaths report","date":"2023-03-31","coroner":"Anna Crawford","area":"Surrey","ref":"2023-0112","categories":["Emergency services related deaths (2019 onwards)"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2023/04/2023-0112-Response-from-South-East-Coast-Ambul