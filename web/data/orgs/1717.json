coroner":"Richard Travers","area":"Surrey","ref":"2022-0031","categories":["Child Death (from 2015)","Hospital Death (Clinical Procedures and medical management) related deaths","Mental Health related deaths","Other related deaths","Railway related deaths","Suicide (from 2015)"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2022/02/2022-0031-Response-from-Surrey-County-Council_Published.pdf","filename":"2022-0031-Response-from-Surrey-County-Council_Published.pdf","promises":[{"id":306,"quote":"On 30 November 2021 the Executive Director for Children Families, Lifelong Learning and Culture wrote to all staff in the Directorate setting out the Autism Awareness Training offer available for all staff in the Directorate. The training is now mandatory for all staff working directly with children and young people and must be completed by 31 March 2022. The uptake of the training is being monitored for each individual. The awareness training must also be completed by all new starters as they","summary":"Mandatory autism training for staff working with children by 31 March 2022","timescale":"31 March 2022"}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/charles-stringer-prevention-of-future-deaths-report/","title":"Charles Stringer: Prevention of future deaths report","date":"2022-10-10","coroner":"Karen Henderson","area":"Surrey","ref":"2022-0317","categories":["Road (Highways Safety) related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2022/10/2022-0317-Response-from-Surrey-County-Council.pdf","filename":"2022-0317-Response-from-Surrey-County-Council.pdf","promises":[{"id":675,"quote":"We have recently reprocured our Highways Term Maintenance contract and have taken the opportunity to consider improvements to the services we deliver. For example, SCC have now increased the potential to be able to carry out larger scale pothole repairs, where conditions warrant it, which will help prevent future potholes and improve road condition for all users.","summary":"Reproduced highways contract to enable larger pothole repairs","timescale":null}]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/kevin-ohara-prevention-of-future-deaths-report/","title":"Kevin O'Hara: Prevention of future deaths report","date":"2023-11-23","coroner":"Susan Ridge","area":"Surrey","ref":"2023-0472","categories":["Other related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2023/11/2023-0472-Response-from-Surrey.pdf","filename":"2023-0472-Response-from-Surrey.pdf","promises":[],"unmatched":true}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/barbara-woodman-prevention-of-future-deaths-report/","title":"Barbara Woodman: Prevention of future deaths report","date":"2023-12-22","coroner":"Darren Stewart","area":"Surrey","ref":"2024-0100","categories":["Alcohol, drug and medication related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2024/02/2024-0100-Surrey-Council-and-Surrey-NHS-Joint-Response.pdf","filename":"2024-0100-Surrey-Council-and-Surrey-NHS-Joint-Response.pdf","promises":[]}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/jake-baker-prevention-of-future-deaths-report/","title":"Jake Baker: Prevention of future deaths report","date":"2024-02-08","coroner":"Caroline Topping","area":"Surrey","ref":"2024-0068","categories":["Other related deaths"],"responses":[{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2024/02/2024-0068-Response-from-Care-Quality-Commission.pdf","filename":"2024-0068-Response-from-Care-Quality-Commission.pdf","promises":[],"unmatched":true},{"pdf_url":"https://www.judiciary.uk/wp-content/uploads/2024/02/2024-0068-Response-from-Surrey-County-Council.pdf","filename":"2024-0068-Response-from-Surrey-County-Council.pdf","promises":[],"unmatched":true}]},{"url":"https://www.judiciary.uk/prevention-of-future-death-reports/john-bass-pr